<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_focused="true">
		<layer-list>
			<item>
				<shape>
					android:shape="rectangle">
					<stroke android:width="1dp" android:color="#959595" />
					<solid android:color="#707070" />
					<corners android:radius="6dp" />
				</shape>
			</item>
			<item
				android:left="2dp"
				android:right="2dp"
				android:top="2dp"
				android:bottom="2dp">
				<shape>
					<gradient
						android:startColor="#A7A7A7"
						android:centerColor="#BEBEBE"
						android:endColor="#808080"
						android:angle="270"/>
					<corners android:radius="5dp" />
				</shape>
			</item>
		</layer-list>
	</item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
				<shape>
					android:shape="rectangle">
					<stroke android:width="1dp" android:color="#707070" />
					<solid android:color="#707070" />
					<corners android:radius="6dp" />
				</shape>
            </item>
            <item         
                android:left="2dp"
		        android:right="2dp"
		        android:top="2dp" 
		        android:bottom="2dp">
				<shape>
				    <gradient
				        android:startColor="#A7A7A7"
				        android:centerColor="#BEBEBE"
				        android:endColor="#808080"
				        android:angle="270"/>
				    <corners android:radius="5dp" />
				</shape>
			</item>
		</layer-list>        
    </item>
    <item>
        <layer-list>
            <item>
				<shape>
					android:shape="rectangle">
					<stroke android:width="1dp" android:color="#909090" />
					<solid android:color="#909090" />
					<corners android:radius="6dp" />
				</shape>
            </item>
            <item         
                android:left="2dp"
		        android:right="2dp"
		        android:top="2dp" 
		        android:bottom="2dp">
				<shape>
				    <gradient
				        android:startColor="#C7C7C7"
				        android:centerColor="#CECECE"
				        android:endColor="#A0A0A0"
				        android:angle="270"/>
				    <corners android:radius="5dp" />
				</shape>
			</item>
		</layer-list>        
    </item>
</selector>
